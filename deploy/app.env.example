# lab-reservation-system backend runtime config.
# 用法: cp deploy/app.env.example config/app.env  (放在 jar 同级的 config/ 下), 填入真实值。
# config/app.env 不入库; 本文件为模板, 可入库。

# ---- database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lab_reservation
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME

# ---- JWT (>=32 bytes) , e.g. openssl rand -hex 48 ----
JWT_SECRET=CHANGE_ME

# ---- listen port ----
# Spring Boot 读取 SERVER_PORT; PORT 仅部署脚本自用, 建议与 SERVER_PORT 保持一致。
SERVER_PORT=8090
PORT=8090

# ---- redis (会话白名单, 可选) ----
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
